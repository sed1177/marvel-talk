<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Marvel-Talk</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

    <style>

        /* gotta fix a fucking mime error later so for now the styles go HERE */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}
.logout-btn{
    text-align: center;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  color: #e8e8e8;
  min-height: 100vh;
  padding: 20px;
}

h1 {
  text-align: center;
  font-size: 2.5rem;
  font-weight: 700;
  background: linear-gradient(135deg, #2d5016 0%, #4a7c2a 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  margin-bottom: 40px;
  letter-spacing: -1px;
}

/* Post Form Styling */
.post-form {
  max-width: 650px;
  margin: 0 auto 50px;
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(45, 80, 22, 0.3);
  border-radius: 16px;
  padding: 24px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
}

textarea {
  width: 100%;
  min-height: 100px;
  padding: 16px;
  margin-bottom: 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 12px;
  color: #e8e8e8;
  font-family: inherit;
  font-size: 15px;
  resize: vertical;
  transition: all 0.3s ease;
}

textarea:focus {
  outline: none;
  border-color: #2d5016;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.2);
}

textarea::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

.input-row {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 16px;
}

input[type="file"],
input[type="text"] {
  width: 100%;
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 10px;
  color: #e8e8e8;
  font-family: inherit;
  font-size: 14px;
  transition: all 0.3s ease;
}

input[type="text"]:focus {
  outline: none;
  border-color: #2d5016;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 0 0 3px rgba(45, 80, 22, 0.2);
}

input[type="text"]::placeholder {
  color: rgba(255, 255, 255, 0.4);
}

input[type="file"]::file-selector-button {
  padding: 8px 16px;
  background: rgba(45, 80, 22, 0.2);
  border: 1px solid rgba(45, 80, 22, 0.4);
  border-radius: 6px;
  color: #4a7c2a;
  cursor: pointer;
  margin-right: 12px;
  font-weight: 600;
  transition: all 0.3s ease;
}

input[type="file"]::file-selector-button:hover {
  background: rgba(45, 80, 22, 0.3);
}

button {
  padding: 12px 32px;
  background: linear-gradient(135deg, #2d5016 0%, #1a4d2e 100%);
  border: none;
  border-radius: 10px;
  color: #fff;
  font-weight: 600;
  font-size: 15px;
  cursor: pointer;
  transition: all 0.3s ease;
  box-shadow: 0 4px 15px rgba(45, 80, 22, 0.4);
}

button:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(45, 80, 22, 0.6);
  background: linear-gradient(135deg, #3d6b1f 0%, #2d5016 100%);
}

button:active {
  transform: translateY(0);
}

.post-form button[type="submit"] {
  width: 100%;
  padding: 14px;
  font-size: 16px;
}

/* Posts Feed */
.posts {
  max-width: 650px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.post {
  background: rgba(255, 255, 255, 0.03);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(45, 80, 22, 0.2);
  border-radius: 16px;
  padding: 24px;
  transition: all 0.3s ease;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
}

.post:hover {
  border-color: rgba(45, 80, 22, 0.4);
  box-shadow: 0 8px 30px rgba(45, 80, 22, 0.2);
  transform: translateY(-2px);
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
  gap: 12px;
}

.avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
  border: 2px solid rgba(45, 80, 22, 0.5);
  box-shadow: 0 2px 8px rgba(45, 80, 22, 0.3);
}

.post-header strong {
  font-size: 15px;
  color: #4a7c2a;
  font-weight: 600;
}

.post-content {
  margin-bottom: 16px;
}

.post-content p {
  line-height: 1.6;
  color: #d0d0d0;
  font-size: 15px;
  margin-bottom: 12px;
  word-wrap: break-word;
}

.post-image {
  width: 100%;
  border-radius: 12px;
  margin-top: 12px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3);
  border: 1px solid rgba(45, 80, 22, 0.2);
}

.post-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.post-actions button {
  padding: 8px 16px;
  font-size: 14px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: none;
  flex-shrink: 0;
}

.post-actions button:hover {
  background: rgba(255, 255, 255, 0.08);
  transform: none;
}

.like-btn:hover {
  border-color: rgba(45, 80, 22, 0.6);
  background: rgba(45, 80, 22, 0.2);
  color: #4a7c2a;
}

.dislike-btn:hover {
  border-color: rgba(244, 67, 54, 0.5);
  background: rgba(244, 67, 54, 0.1);
}

.delete-form {
  display: inline-block;
}

.delete-form button {
  background: rgba(244, 67, 54, 0.1);
  border: 1px solid rgba(244, 67, 54, 0.3);
  color: #f44336;
  box-shadow: none;
}

.delete-form button:hover {
  background: rgba(244, 67, 54, 0.2);
  border-color: rgba(244, 67, 54, 0.5);
  box-shadow: none;
}

/* Responsive design */
@media (max-width: 768px) {
  h1 {
    font-size: 2rem;
  }
  
  .post-form,
  .posts {
    padding: 0 10px;
  }
  
  .post {
    padding: 20px;
  }
}
    </style>
</head>
<body>
    <h1>Marvel-Talk Feed</h1>
            <a href="/logout" class="logout-btn btn-default btn-sm">Logout</a>

    
 <form action="/post" method="POST" enctype="multipart/form-data" class="post-form">
  <textarea name="content" placeholder="What's on your mind about Marvel?" required></textarea>
  
  <div class="input-row">
    <input type="file" name="image" accept="image/*">
    <input type="text" name="imageUrl" placeholder="Or paste an image URL">
  </div>

  <button type="submit">Post</button>
</form>

<div class="posts">
    <!-- for each POST -->
  <% posts.forEach(post => { %>
    <div class="post">
      <div class="post-header">
        <img src="<%='./img/daDOOM.jpg' %>" class="avatar" alt="avatar">
        <strong><%= post.user %></strong>
      </div>
      <div class="post-content">
        <p><%= post.content %></p>
        <% if(post.imageUrl) { %>
          <img src="<%= post.imageUrl %>" class="post-image" alt="Post image">
        <% } %>
      </div>
      <div class="post-actions">
        <button class="like-btn" data-id="<%= post._id %>">👍 <%= post.likes %></button>
        <button class="dislike-btn" data-id="<%= post._id %>">👎 <%= post.dislikes %></button>
        <% if(post.user === user.local.email) { %>
         <form action="/post/delete/<%= post._id %>" method="POST" class="delete-form">
            <button type="submit">Delete</button>
          </form>
        <% } %>
      </div>
    </div>
  <% }) %>
</div>

<script src="/main.js"></script>
</body>
</html>